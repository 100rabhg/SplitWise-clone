.container.mt-4.mb-5
  .row.justify-content-center
    .col-md-8
      .card.shadow-sm
        .card-header.bg-white.border-bottom.d-flex.justify-content-between.align-items-center
          div
            h2.mb-0.h4 Payment Details
            p.text-muted.small.mb-0= @payment.created_at.strftime('%B %d, %Y at %I:%M %p')
          span.badge.bg-success.fs-5= number_to_currency(@payment.amount)
        .card-body.p-4
          .row.mb-4
            .col-md-6
              h6.text-muted.text-uppercase.small.mb-2 Paid By
              .d-flex.align-items-center.gap-2
                i.bi.bi-person-circle.text-primary style="font-size: 24px;"
                span.fw-bold= @payment.paid_by.name
            .col-md-6
              h6.text-muted.text-uppercase.small.mb-2 Between
              .d-flex.align-items-center.gap-2
                i.bi.bi-people.text-secondary style="font-size: 24px;"
                span.fw-medium= "#{@payer_options[0][0]} & #{@payer_options[1][0]}"
          
          - if @payment.notes.present?
            .mb-4
              h6.text-muted.text-uppercase.small.mb-2 Notes
              p.mb-0= @payment.notes
          
          .d-flex.gap-2.justify-content-end.mt-4
            = link_to 'Edit', edit_payment_path(@payment), class: 'btn btn-outline-secondary'
            = link_to 'Back', :back, class: 'btn btn-outline-secondary'
            - if @payment.paid_by_id == current_user.id
              = link_to 'Edit Payment', edit_payment_path(@payment), class: 'btn btn-primary'
