.container.mt-4.mb-5
  .row.justify-content-center
    .col-md-8
      .card.shadow-sm
        .card-header.bg-white.border-bottom
          h2.mb-0.h4 Edit Payment
          p.text-muted.small.mb-0 Update payment details
        .card-body.p-4
          = form_with model: @payment, url: payment_path(@payment), method: :patch, local: true, class: 'needs-validation' do |f|
            .row
              .col-md-6.mb-4
                = f.label :amount, 'Amount', class: 'form-label fw-medium'
                .input-group
                  span.input-group-text ₹
                  = f.number_field :amount, step: '0.01', class: 'form-control', placeholder: '0.00', required: true

              .col-md-6.mb-4
                = f.label :notes, 'Notes (optional)', class: 'form-label fw-medium'
                .input-group
                  span.input-group-text
                    i.bi.bi-chat-left-text
                  = f.text_field :notes, class: 'form-control', placeholder: 'Add a note...'

            .d-flex.gap-2.justify-content-end.mt-3
              = link_to 'Cancel', :back, class: 'btn btn-outline-secondary'
              = f.submit 'Update Payment', class: 'btn btn-success'