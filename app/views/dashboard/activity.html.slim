.dashboard-wrapper
  aside.side-bar-area
    = render 'shared/sidebar'
  .main-area
    .top-bar
      h1.top-bar-title Activity
      .top-bar-actions
        = link_to 'Add Expense', new_expense_path, class: 'btn btn-primary me-2'
        = link_to 'Dashboard', root_path, class: 'btn btn-outline-secondary'
    .p-4
      - if @transactions.any?
        .list-group
          - @transactions.each do |tx|
            = render 'shared/transaction_row', tx: tx, current_user: current_user, show_actions: false
      - else
        .text-center.py-5
          i.bi.bi-inbox.text-muted style="font-size: 48px;"
          p.text-muted.mt-3 No activity yet
