doctype html
html
  head
    title
      | BE Assignment Junior
    = render 'layouts/header_layout'
    / Bootstrap Icons CDN for using icon fonts
    link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    - if user_signed_in?
      meta name="current-user-id" content="#{current_user.id}"
  - if ['sessions' , 'registrations', 'passwords'].include?(controller_name)
    body.text-center
      main.form-signin
        = yield
  - else
    body.d-flex.flex-column.h-100
      = render 'layouts/top_nav_bar'
    main.flex-shrink-0
      .container-fluid
        = yield

= render 'layouts/jgrowl_notifications'