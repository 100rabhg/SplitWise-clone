<h1 class="h3 mb-3 fw-normal">Change your password</h1>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, autocomplete: "off" }) do |f| %>
  <%= f.error_notification %>

  <%= f.input :reset_password_token, as: :hidden %>
  <%= f.full_error :reset_password_token %>

  <div class="form-group mb-4">
    <div class="form-floating">
      <%= f.input :password,
                  required: true,
                  autofocus: true, wrapper: false, label: false,
                  input_html: { autocomplete: 'off', class: "form-control" } %>
      <%= f.label :password %>
    </div>
    <div class="form-floating">
      <%= f.input :password_confirmation,
                  required: true, wrapper: false, label: false,
                  input_html: { autocomplete: 'off', class: "form-control" } %>
      <%= f.label :password_confirmation %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Change my password", class: 'w-100 btn btn-lg btn-primary' %>
  </div>
<% end %>

<%= render "devise/shared/links" %>


