<h1 class="h3 mb-3 fw-normal">Forgot your password?</h1>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, autocomplete: "off" }) do |f| %>
  <%= f.error_notification %>

  <div class="form-group mb-4">
    <div class="form-floating">
      <%= f.input :email,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "email", class: "form-control", id: "floatingEmail" },
                label: false,
                wrapper: false %>
      <label for="floatingEmail">Email address</label>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :button, "Send reset instructions", class: "w-100 btn btn-lg btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
