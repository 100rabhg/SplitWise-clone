- is_payment = tx.is_a?(PaymentTransaction)
- is_payer = tx.paid_by_id == current_user.id
- can_view = is_payment || (!is_payer && !is_payment)
- can_edit = is_payment || (is_payer && !is_payment)
- primary_path = can_view ? transaction_path(tx) : edit_path_for(tx)
- label = is_payment ? 'Payment' : (tx.notes.presence || 'Expense')
- show_actions = local_assigns.fetch(:show_actions, true)

.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center.text-decoration-none.activity-item

  = link_to primary_path, class: 'd-flex align-items-center gap-3 text-decoration-none flex-grow-1' do
    .date-box.text-center.border.rounded.p-2.bg-light style="min-width: 70px;"
      p.mb-0.small.text-muted= tx.created_at.strftime('%b')
      p.mb-0.fw-bold= tx.created_at.strftime('%d')

    .content-box
      .d-flex.align-items-center.gap-2
        - if is_payment
          i.bi.bi-cash-stack.text-success style="font-size: 20px;"
        - else
          i.bi.bi-receipt.text-primary style="font-size: 20px;"
        p.mb-0.fw-bold.text-dark= label

      small.text-muted= "Paid by #{tx.paid_by.name}"

  .d-flex.align-items-center.gap-3
    = transaction_share_badge(tx, current_user, friend: local_assigns[:friend])

    / Only show total for expenses (not payments, since total = share for payments)
    - unless is_payment
      span.badge.bg-secondary.text-white style="font-size: 0.75rem;"
        | total: #{number_to_currency(tx.amount)}

    - if show_actions
      .actions.d-flex.gap-1
        - if can_edit
          = link_to edit_path_for(tx),
              class: 'btn btn-sm btn-link text-secondary',
              title: 'Edit' do
            i.bi.bi-pencil

          = link_to transaction_path(tx),
              method: :delete,
              data: { confirm: 'Are you sure?' },
              class: 'btn btn-sm btn-link text-danger',
              title: 'Delete' do
            i.bi.bi-trash
        - else
          i.bi.bi-eye title='View'
